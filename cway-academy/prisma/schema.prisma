// ========================================================
// CWAY Academy — Prisma Schema
// Database: PostgreSQL
// ========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  INFO_REQUESTED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
  SUSPENDED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  CERTIFICATE
  DIPLOMA
}

enum CourseFormat {
  SELF_PACED
  COHORT
  HYBRID
  LIVE_ONLY
}

enum LessonType {
  VIDEO
  TEXT
  QUIZ
  ASSIGNMENT
  LIVE_SESSION
  DOCUMENT
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
  RETURNED
  LATE
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  STRIPE
  BANK_TRANSFER
  CHEQUE
}

enum ScholarshipType {
  FULL
  PARTIAL
  MERIT
  NEED_BASED
}

enum ScholarshipStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  EXPIRED
}

enum CertificateStatus {
  ISSUED
  REVOKED
  EXPIRED
}

enum NotificationType {
  ANNOUNCEMENT
  GRADE
  ASSIGNMENT
  ENROLLMENT
  CERTIFICATE
  PAYMENT
  SCHOLARSHIP
  PRAYER
  SYSTEM
}

// ─────────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────────

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  emailVerified     DateTime?
  name              String?
  firstName         String?
  lastName          String?
  image             String?
  passwordHash      String?
  role              Role      @default(STUDENT)
  isActive          Boolean   @default(true)
  bio               String?
  phone             String?
  address           String?
  city              String?
  state             String?
  country           String?   @default("India")
  language          String?   @default("en")
  profileComplete   Boolean   @default(false)
  metadata          Json?     @db.JsonB
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  // Relations
  accounts          Account[]
  sessions          Session[]
  enrollments       Enrollment[]
  submissions       Submission[]
  certificates      Certificate[]
  notifications     Notification[]
  prayerRequests    PrayerRequest[]
  blogPosts         BlogPost[]
  comments          Comment[]
  donations         Donation[]
  scholarships      StudentScholarship[]
  applications      Application[]
  instructorCourses Course[]             @relation("InstructorCourses")
  announcements     Announcement[]
  progressRecords   LessonProgress[]
  auditLogs         AuditLog[]
  discussionPosts   DiscussionPost[]
  attendanceRecords Attendance[]
  sentMessages      Message[]            @relation("SentMessages")
  receivedMessages  Message[]            @relation("ReceivedMessages")

  @@index([email])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────
// COURSES & CURRICULUM
// ─────────────────────────────────────────────

model Course {
  id               String      @id @default(cuid())
  slug             String      @unique
  title            String
  subtitle         String?
  description      String      @db.Text
  fullDescription  String?     @db.Text
  thumbnail        String?
  previewVideo     String?
  level            CourseLevel @default(BEGINNER)
  format           CourseFormat @default(SELF_PACED)
  language         String      @default("en")
  duration         String?     // e.g. "12 weeks"
  totalHours       Float?
  credits          Int?
  price            Decimal?    @db.Decimal(10, 2)
  isFree           Boolean     @default(true)
  isPublished      Boolean     @default(false)
  isArchived       Boolean     @default(false)
  instructorId     String
  categoryId       String?
  tags             String[]
  objectives       String[]
  prerequisites    String[]
  targetAudience   String?
  certificate      Boolean     @default(true)
  maxStudents      Int?
  startDate        DateTime?
  endDate          DateTime?
  metadata         Json?       @db.JsonB
  searchVector     Unsupported("tsvector")?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  // Relations
  instructor       User        @relation("InstructorCourses", fields: [instructorId], references: [id])
  category         Category?   @relation(fields: [categoryId], references: [id])
  modules          Module[]
  enrollments      Enrollment[]
  certificates     Certificate[]
  announcements    Announcement[]
  discussions      Discussion[]
  liveSessions     LiveSession[]

  @@index([slug])
  @@index([instructorId])
  @@index([isPublished])
  @@index([level])
  @@index([format])
  @@map("courses")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  color       String?
  parentId    String?
  parent      Category? @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  courses     Course[]
  createdAt   DateTime  @default(now())

  @@map("categories")
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  position    Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@index([courseId])
  @@map("modules")
}

model Lesson {
  id           String     @id @default(cuid())
  moduleId     String
  title        String
  content      String?    @db.Text
  videoUrl     String?
  documentUrl  String?
  duration     Int?       // seconds
  type         LessonType @default(VIDEO)
  position     Int        @default(0)
  isPublished  Boolean    @default(false)
  isFree       Boolean    @default(false)
  resources    Json?      @db.JsonB
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  module       Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress     LessonProgress[]
  quiz         Quiz?
  assignment   Assignment?

  @@index([moduleId])
  @@map("lessons")
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean  @default(false)
  watchedSec  Int?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("lesson_progress")
}

// ─────────────────────────────────────────────
// QUIZZES & ASSIGNMENTS
// ─────────────────────────────────────────────

model Quiz {
  id            String   @id @default(cuid())
  lessonId      String   @unique
  title         String
  instructions  String?
  passingScore  Int      @default(70)
  maxAttempts   Int      @default(3)
  timeLimitMin  Int?
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions     QuizQuestion[]
  submissions   QuizSubmission[]

  @@map("quizzes")
}

model QuizQuestion {
  id           String   @id @default(cuid())
  quizId       String
  question     String
  type         String   @default("MULTIPLE_CHOICE")
  options      Json     @db.JsonB
  correctAnswer Json    @db.JsonB
  explanation  String?
  points       Int      @default(1)
  position     Int      @default(0)

  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("quiz_questions")
}

model QuizSubmission {
  id          String   @id @default(cuid())
  quizId      String
  userId      String
  answers     Json     @db.JsonB
  score       Float
  passed      Boolean
  attempt     Int      @default(1)
  submittedAt DateTime @default(now())

  quiz        Quiz     @relation(fields: [quizId], references: [id])

  @@index([quizId, userId])
  @@map("quiz_submissions")
}

model Assignment {
  id           String    @id @default(cuid())
  lessonId     String    @unique
  title        String
  instructions String    @db.Text
  dueDate      DateTime?
  maxPoints    Int       @default(100)
  isPublished  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lesson       Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions  Submission[]

  @@map("assignments")
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  userId       String
  content      String?          @db.Text
  fileUrls     String[]
  grade        Float?
  feedback     String?          @db.Text
  status       SubmissionStatus @default(SUBMITTED)
  submittedAt  DateTime         @default(now())
  gradedAt     DateTime?

  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@index([assignmentId, userId])
  @@map("submissions")
}

// ─────────────────────────────────────────────
// ENROLLMENTS & ATTENDANCE
// ─────────────────────────────────────────────

model Enrollment {
  id         String           @id @default(cuid())
  userId     String
  courseId   String
  status     EnrollmentStatus @default(ACTIVE)
  progress   Float            @default(0)
  enrolledAt DateTime         @default(now())
  completedAt DateTime?
  expiresAt  DateTime?

  user       User     @relation(fields: [userId], references: [id])
  course     Course   @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("enrollments")
}

model LiveSession {
  id           String    @id @default(cuid())
  courseId     String
  title        String
  description  String?
  scheduledAt  DateTime
  duration     Int?      // minutes
  meetingUrl   String?
  recordingUrl String?
  isCompleted  Boolean   @default(false)
  createdAt    DateTime  @default(now())

  course       Course    @relation(fields: [courseId], references: [id])
  attendance   Attendance[]

  @@index([courseId])
  @@map("live_sessions")
}

model Attendance {
  id            String    @id @default(cuid())
  userId        String
  liveSessionId String
  joinedAt      DateTime?
  leftAt        DateTime?
  duration      Int?

  user        User        @relation(fields: [userId], references: [id])
  liveSession LiveSession @relation(fields: [liveSessionId], references: [id])

  @@unique([userId, liveSessionId])
  @@map("attendance")
}

// ─────────────────────────────────────────────
// APPLICATIONS & ADMISSIONS
// ─────────────────────────────────────────────

model Application {
  id                String            @id @default(cuid())
  userId            String?
  status            ApplicationStatus @default(PENDING)
  firstName         String
  lastName          String
  email             String
  phone             String
  dateOfBirth       DateTime?
  gender            String?
  address           String?
  city              String?
  state             String?
  country           String?
  church            String?
  denomination      String?
  yearsInMinistry   Int?
  ministry          String?
  testimony         String?           @db.Text
  courseId          String?
  scholarshipRequest Boolean          @default(false)
  scholarshipReason  String?          @db.Text
  documents         String[]
  adminNotes        String?           @db.Text
  reviewedBy        String?
  reviewedAt        DateTime?
  savedAt           DateTime?
  submittedAt       DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user              User?             @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([email])
  @@map("applications")
}

// ─────────────────────────────────────────────
// CERTIFICATES
// ─────────────────────────────────────────────

model Certificate {
  id            String            @id @default(cuid())
  userId        String
  courseId      String
  certificateId String            @unique @default(cuid())
  title         String
  issuedAt      DateTime          @default(now())
  expiresAt     DateTime?
  status        CertificateStatus @default(ISSUED)
  pdfUrl        String?
  metadata      Json?             @db.JsonB

  user          User     @relation(fields: [userId], references: [id])
  course        Course   @relation(fields: [courseId], references: [id])

  @@index([userId])
  @@index([certificateId])
  @@map("certificates")
}

// ─────────────────────────────────────────────
// SCHOLARSHIPS
// ─────────────────────────────────────────────

model Scholarship {
  id            String          @id @default(cuid())
  name          String
  description   String          @db.Text
  amount        Decimal?        @db.Decimal(10, 2)
  type          ScholarshipType @default(NEED_BASED)
  fundedBy      String?
  requirements  String[]
  deadline      DateTime?
  isActive      Boolean         @default(true)
  maxRecipients Int?
  createdAt     DateTime        @default(now())

  recipients    StudentScholarship[]

  @@map("scholarships")
}

model StudentScholarship {
  id            String            @id @default(cuid())
  userId        String
  scholarshipId String
  status        ScholarshipStatus @default(PENDING)
  amount        Decimal?          @db.Decimal(10, 2)
  reason        String?           @db.Text
  approvedBy    String?
  approvedAt    DateTime?
  expiresAt     DateTime?
  createdAt     DateTime          @default(now())

  user          User        @relation(fields: [userId], references: [id])
  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id])

  @@map("student_scholarships")
}

// ─────────────────────────────────────────────
// DONATIONS & PARTNERSHIPS
// ─────────────────────────────────────────────

model Donation {
  id              String         @id @default(cuid())
  userId          String?
  name            String?
  email           String?
  amount          Decimal        @db.Decimal(10, 2)
  currency        String         @default("INR")
  method          PaymentMethod  @default(RAZORPAY)
  status          DonationStatus @default(PENDING)
  transactionId   String?
  purpose         String?
  isRecurring     Boolean        @default(false)
  message         String?        @db.Text
  isAnonymous     Boolean        @default(false)
  metadata        Json?          @db.JsonB
  createdAt       DateTime       @default(now())

  user            User?          @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([email])
  @@map("donations")
}

model Partnership {
  id              String   @id @default(cuid())
  organizationName String
  contactName     String
  email           String
  phone           String?
  website         String?
  partnerType     String
  description     String?  @db.Text
  status          String   @default("PENDING")
  approvedAt      DateTime?
  createdAt       DateTime @default(now())

  @@map("partnerships")
}

// ─────────────────────────────────────────────
// BLOG & CMS
// ─────────────────────────────────────────────

model BlogPost {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  excerpt      String?
  content      String    @db.Text
  thumbnail    String?
  authorId     String
  categoryId   String?
  tags         String[]
  isPublished  Boolean   @default(false)
  publishedAt  DateTime?
  readTime     Int?
  metadata     Json?     @db.JsonB
  searchVector Unsupported("tsvector")?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  author       User      @relation(fields: [authorId], references: [id])
  comments     Comment[]

  @@index([slug])
  @@index([authorId])
  @@index([isPublished])
  @@map("blog_posts")
}

model Comment {
  id         String   @id @default(cuid())
  postId     String
  userId     String
  content    String   @db.Text
  isApproved Boolean  @default(false)
  parentId   String?
  parent     Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies    Comment[] @relation("CommentReplies")
  createdAt  DateTime @default(now())

  post       BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])

  @@index([postId])
  @@map("comments")
}

// ─────────────────────────────────────────────
// DISCUSSIONS
// ─────────────────────────────────────────────

model Discussion {
  id        String           @id @default(cuid())
  courseId  String
  title     String
  createdAt DateTime         @default(now())

  course    Course           @relation(fields: [courseId], references: [id])
  posts     DiscussionPost[]

  @@map("discussions")
}

model DiscussionPost {
  id           String     @id @default(cuid())
  discussionId String
  userId       String
  content      String     @db.Text
  parentId     String?
  parent       DiscussionPost? @relation("PostReplies", fields: [parentId], references: [id])
  replies      DiscussionPost[] @relation("PostReplies")
  createdAt    DateTime   @default(now())

  discussion   Discussion @relation(fields: [discussionId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@map("discussion_posts")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS & MESSAGES
// ─────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model Announcement {
  id          String   @id @default(cuid())
  courseId    String?
  authorId    String
  title       String
  content     String   @db.Text
  isPinned    Boolean  @default(false)
  isGlobal    Boolean  @default(false)
  createdAt   DateTime @default(now())

  course      Course?  @relation(fields: [courseId], references: [id])
  author      User     @relation(fields: [authorId], references: [id])

  @@index([courseId])
  @@map("announcements")
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  subject     String?
  content     String   @db.Text
  isRead      Boolean  @default(false)
  readAt      DateTime?
  createdAt   DateTime @default(now())

  sender      User     @relation("SentMessages", fields: [senderId], references: [id])
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([receiverId])
  @@map("messages")
}

// ─────────────────────────────────────────────
// PRAYER REQUESTS
// ─────────────────────────────────────────────

model PrayerRequest {
  id           String   @id @default(cuid())
  userId       String?
  name         String?
  email        String?
  subject      String
  request      String   @db.Text
  isAnswered   Boolean  @default(false)
  isPublic     Boolean  @default(false)
  prayerCount  Int      @default(0)
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id])

  @@map("prayer_requests")
}

// ─────────────────────────────────────────────
// AUDIT LOGS
// ─────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  resource   String
  resourceId String?
  oldValue   Json?    @db.JsonB
  newValue   Json?    @db.JsonB
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}
